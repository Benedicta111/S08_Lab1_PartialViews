@{
}

@model IEnumerable<HuntingLog>

	
<div>
		<table>
	<tbody>
@foreach (var item in Model)
{
	<tr>
		<td width="80%">
			<a class="btn btn-info" asp-action="Create" asp-route-id="@item.Id">
				@item.Title
			</a>
		</td>
		<td class="text-center">
			<div class="w-75 btn-group" role="group">
				<a class="btn btn-info mx-2" asp-action="Edit" asp-route-Id="@item.Id">
					Edit
				</a>
				<a class="btn btn-danger mx-2" asp-action="Delete" asp-route-Id="@item.Id">
					Delete
				</a>
			</div>
		</td>
	</tr>
}
</tbody>
		</table>
</div>
   